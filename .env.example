# Base de datos (Supabase: Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=3

# Fotos (Supabase: Project Settings > API). Usa la clave service_role: solo en el servidor, nunca en el navegador.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_BUCKET=fotos

# Usuario administrador inicial (solo se usa si la base está vacía)
ADMIN_USER=admin
ADMIN_PIN=cambia-este-pin
